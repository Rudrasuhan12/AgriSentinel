# ==============================================================================
# AgriSentinel — Environment Configuration Template
# ==============================================================================

# Database Configuration (PostgreSQL + PostGIS via Docker)
POSTGRES_DB=agrisentinel_db
POSTGRES_USER=agrisentinel_user
POSTGRES_PASSWORD=CHANGE_ME_SECURE_PASSWORD
POSTGRES_PORT=5436
DATABASE_URL=postgresql+asyncpg://agrisentinel_user:CHANGE_ME_SECURE_PASSWORD@127.0.0.1:5436/agrisentinel_db
DATABASE_SYNC_URL=postgresql://agrisentinel_user:CHANGE_ME_SECURE_PASSWORD@127.0.0.1:5436/agrisentinel_db

# Security & JWT Token Secrets
JWT_SECRET_KEY=CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_HEX_32
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14

# Initial Administrator Bootstrap (Development Only)
INITIAL_ADMIN_EMAIL=admin@agrisentinel.local
INITIAL_ADMIN_MOBILE=9876543210
INITIAL_ADMIN_PASSWORD=AdminSecurePass@2026

# Backend Server Configuration
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
FRONTEND_PORT=5173
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Geospatial Tiles & Map Services
MAP_TILE_URL=
MAP_API_KEY=

# Development Mock Services (Set to false in production)
MOCK_OTP_MODE=true
